<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE gpc>
<!-- +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-->
<!--                      Configuration file for GPC                    -->
<!-- +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-->
<gpc version="1.0">
<!--                         -+-+-+-+-+-+-+-+-                          -->
<!--                         A few definitions                          -->
<!--                         -+-+-+-+-+-+-+-+-                          -->
    <!--define        name="QtRoot" value="C:\Disk\Tools\Qt\Qt-6.5.0"/-->
    <define name="QtRoot" value="C:\My_Partition\Tools\Qt\Qt5.14.1\5.14.1\msvc2017"/>
    <define name="QtBin" value="%QtRoot%/bin"/>
    <define name="QtInc" value="%QtRoot%/include"/>
    <define name="QtLib" value="%QtRoot%/lib"/>
<!--                             -+-+-+-+-                              -->
<!--                             Compilers                              -->
<!--                             +-+-+-+-+-                             -->
    <compiler name="lex">
        <exec_name>flex</exec_name>
        <options project="yes">%flags% -P%project% -o%target% %source%</options>
        <options project="no">%flags% -o%target% %source%</options>
    </compiler>
    <compiler name="yacc">
        <exec_name>bison</exec_name>
        <options project="yes">-t -v %flags% -p%project% -o%target% %source%</options>
        <options project="no">-t -v %flags% -o%target% %source%</options>
    </compiler>
		<compiler name="moc">
		<command>%QtBin%/moc -o %target% %source%</command>
    </compiler>
    <compiler name="rcc">
		<command>%QtBin%/rcc -o %target% -name %project% %source%</command>
    </compiler>
    <compiler name="cc">
        <object_file_extension>.o</object_file_extension>
        <object_file_extension>.obj</object_file_extension>
        <exe_file_extension></exe_file_extension>
        <exe_file_extension>.exe</exe_file_extension>
        <exec_name>cl</exec_name>
		<qt_includes>-I%QtInc% -I%QtInc%/Qt -I%QtInc%/QtCore -I%QtInc%/QtGui -I%QtInc%/QtXml -I%QtInc%/QtMultimedia -I%QtInc%/QtMultimediaWidgets -I%QtInc%/QtNetwork -I%QtInc%/QtOpenGL  -I%QtInc%/QtUiTools -I%QtInc%/QtWidgets -I%QtInc%/QtPrintSupport -I%QtInc%/QtScript -I%QtInc%/activeQt</qt_includes>
        <includes>%qt_includes% -ID:\Tools\GnuWin32\include %project_includes%</includes>
		<compile_options>%ccflags% %includes% -c %source% -o %target%</compile_options>
		<compile_options>%ccflags% -c /W3 -DCRTAPI1=_cdecl -DCRTAPI2=_cdecl -nologo -D_X86_=1 -D_WINNT -D_WIN32_IE=0x0300 -DWIN32 -D_WIN32 -DYYDEBUG /Fo%target% %includes% -I%QtInc%/QtSerialPort %source% </compile_options>
		<libraries>%QtLib%/Qt5AxContainer.lib %QtLib%/Qt5AxBase.lib %QtLib%\Qt5MultimediaWidgets.lib %QtLib%\Qt5Multimedia.lib %QtLib%\Qt5UiTools.lib %QtLib%\Qt5Network.lib %QtLib%\Qt5Xml.lib  %QtLib%\Qt5OpenGL.lib %QtLib%\Qt5PrintSupport.lib %QtLib%\Qt5Gui.lib %QtLib%\Qt5Widgets.lib %QtLib%\Qt5SerialPort.lib %QtLib%\Qt5Core.lib AdvApi32.lib user32.lib ole32.lib oleaut32.lib gdi32.lib comdlg32.lib comctl32.lib Winmm.lib glu32.lib openGL32.lib</libraries>
		<link_options>%ldflags% -o %target% %objects% %libraries%</link_options>
		<link_options>/W3 /DCRTAPI1=_cdecl -DCRTAPI2=_cdecl -nologo -D_X86_=1 -D_WINNT -D_WIN32_WINNT=0x0400 -D_WIN32_IE=0x0300 -DWINVER=0x0400 -DWIN32 -D_WIN32 /Fe%target% %objects% /link %ldflags% %libraries%</link_options>
    </compiler>

<!--                             -+-+-+-+-                              -->
<!--                               Files                                -->
<!--                             +-+-+-+-+-                             -->
    <file extension="l">
        <compiler>lex</compiler>
	<target></target>
    </file>
    <file extension="h">
        <compiler>moc</compiler>
	<target></target>
    </file>

<!--                         -+-+-+-+-+-+-+-+-                          -->
<!--                         Compilation chain                          -->
<!--                         +-+-+-+-+-+-+-+-+-                         -->

    <chain>
        <job kind="compile" name="compile">
           <enable/>
        </job>
        <job kind="link" name="link">
           <enable/>
        </job>
        <job kind="doc" name="doc">
           <disable/>
        </job>
    </chain>
</gpc>

